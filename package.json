{
  "name": "jsonviewer-web",
  "private": true,
  "description": "前端第三方依赖打包（CodeMirror 6、js-yaml、smol-toml）。产物已提交到 web/js/vendor，日常构建 Go 二进制不需要 Node。",
  "scripts": {
    "build:cm": "esbuild web-src/codemirror-entry.js --bundle --minify --format=iife --outfile=web/js/vendor/codemirror.bundle.js",
    "build:yaml": "esbuild web-src/yaml-entry.js --bundle --minify --format=iife --outfile=web/js/vendor/yaml.bundle.js",
    "build:toml": "esbuild web-src/toml-entry.js --bundle --minify --format=iife --outfile=web/js/vendor/toml.bundle.js",
    "build:vendor": "npm run build:cm && npm run build:yaml && npm run build:toml",
    "test:e2e": "node tests/e2e.js",
    "test:formats": "node tests/formats.js"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "js-yaml": "5.4.2",
    "puppeteer-core": "^25.12.0",
    "smol-toml": "1.9.0"
  }
}
